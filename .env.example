# Database
DATABASE_URL="file:./prisma/dev.db"

# Public base URL used when building customer links / QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI review writing via OpenRouter (optional: built-in templates are used when unset)
# OPENROUTER_MODEL is the model id from openrouter.ai/models
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Outgoing email for sign-up verification codes (SSL on 465)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Give Me Five Star <info@givemefivestar.com>"
